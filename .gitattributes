# Normalizza tutti i file di testo a LF nel repository
* text=auto eol=lf

# File esplicitamente di testo
*.php      text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.sql      text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.xml      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.sh       text eol=lf

# File binari — nessuna conversione
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.pdf      binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.eot      binary
